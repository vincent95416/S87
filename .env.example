# Docker Compose 環境變數範本
# 複製此檔為 .env 後修改為部署環境實際路徑：
#   cp .env.example .env
# .env 已在 .gitignore 中，僅存在於部署伺服器本機

# 測試報告輸出目錄（HTML report / JUnit XML / Allure results）
# 本機開發使用 ./reports 即可；部署伺服器改為實際路徑
REPORTS_DIR=./reports

# Web 服務對外埠
# 生產環境建議設為 127.0.0.1:8000 搭配反向代理（nginx/Caddy）
WEB_PORT=8000

# Google Chat incoming webhook URL（tester 任務結束後發通知；留空停用）
# 建立方式：Google Chat 頻道 → 應用程式與整合 → 新增 Webhook
GCHAT_WEBHOOK_URL=

# webservice 對外網址（通知訊息中的「查看完整報告」按鈕會連過去；留空則不顯示按鈕）
# 例如：http://sport-uat-ag-67-77:8000
REPORT_BASE_URL=